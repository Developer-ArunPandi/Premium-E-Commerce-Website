RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=demo@gmail.com
EMAIL_PASS=demo_password
EMAIL_FROM=ShopSphere <noreply@shopsphere.com>

# Admin Seed
ADMIN_EMAIL=admin@shopsphere.com
ADMIN_PASSWORD=Admin@123456
